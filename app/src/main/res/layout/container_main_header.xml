<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_main_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:foreground="@drawable/selectable_item_background"
    android:gravity="bottom|start"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/small_margin"
    android:paddingEnd="@dimen/small_margin"
    android:paddingBottom="@dimen/large_margin"
    tools:ignore="UnusedAttribute">

    <TextView
        android:id="@+id/container_main_header_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/normal_margin"
        android:textColor="?attr/colorSurfaceInverse"
        android:textSize="@dimen/content_text_size"
        android:fontFamily="@font/ibm_plex_mono"
        android:letterSpacing="0.14"
        android:textAllCaps="true"
        tools:text="SATURDAY 18 OCTOBER" />

    <TextView
        android:id="@+id/container_main_header_weather_condition_description"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        android:layout_gravity="start"
        android:textAlignment="viewStart"
        android:textFontWeight="300"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorSurfaceInverse"
        android:fontFamily="@font/ibm_plex_mono"
        tools:text="Sunny"
        tools:ignore="RelativeOverlap,RtlHardcoded" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/container_main_header_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <org.breezyweather.ui.common.widgets.NumberAnimTextView
                    android:id="@+id/container_main_header_temperature_value"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="-10dp"
                    android:textSize="@dimen/main_title_text_size"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:letterSpacing="0"
                    android:textStyle="bold"
                    android:textFontWeight="700"
                    android:layout_alignParentStart="true"
                    android:importantForAccessibility="no"
                    android:textColor="?attr/colorSurfaceInverse"
                    android:fontFamily="@font/d_din"
                    style="@style/large_title_text"
                    tools:text="11"
                    tools:ignore="RelativeOverlap,RtlSymmetry" />

                <TextView
                    android:id="@+id/container_main_header_temperature_unit"
                    android:layout_marginTop="20dp"
                    android:textSize="38sp"
                    android:textFontWeight="700"
                    android:includeFontPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/container_main_header_temperature_value"
                    android:importantForAccessibility="no"
                    android:textColor="@color/colorTextGrey2nd"
                    android:fontFamily="@font/d_din"
                    style="@style/large_title_text"
                    tools:text="°C" />
            </RelativeLayout>

            <TextView
                android:id="@+id/container_main_header_feels_like"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:ellipsize="end"
                android:textFontWeight="300"
                android:layout_marginTop="-10dp"
                android:layout_marginBottom="8dp"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorSurfaceInverse"
                android:fontFamily="@font/ibm_plex_mono"
                tools:text="Feels like 18°"
                tools:ignore="RelativeOverlap,RtlHardcoded" />

            <TextView
                android:id="@+id/container_main_header_temperature_range"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:textAlignment="viewStart"
                android:maxLines="1"
                android:ellipsize="end"
                android:textFontWeight="300"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorSurfaceInverse"
                android:fontFamily="@font/ibm_plex_mono"
                tools:text="Day: 30° • Night: 14°"
                tools:ignore="RelativeOverlap,RtlHardcoded" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/container_main_header_weather_icon"
                android:layout_width="176dp"
                android:layout_height="176dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:translationY="-48dp"
                tools:src="@drawable/weather_cloudy" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_circle"
                    android:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/refreshTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ibm_plex_mono"
                    android:maxLines="1"
                    android:textColor="?attr/colorSurfaceInverse"
                    android:textSize="@dimen/content_text_size"
                    tools:text="11:08" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sync"
                    android:tint="?attr/colorSurfaceInverse" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
